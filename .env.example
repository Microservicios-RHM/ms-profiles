PORT=8080
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=profiles_db
DB_USER=profiles_service
DB_PASSWORD=change_profiles_password
DB_POOL_MAX=5
DB_CONNECT_MAX_ATTEMPTS=5
